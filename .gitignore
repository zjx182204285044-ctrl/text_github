# ============================================================
# STM32H7 + CMake 工程 Git 忽略规则
# ============================================================

# ---------- 1. 编译产物 ----------
build/
out/
*.elf
*.hex
*.bin
*.map
*.o
*.obj
*.d
*.su
*.lst

# ---------- 2. 本地缓存 ----------
.cache/
.idea/
# 注意：.settings/ 和 .mxproject 要上传，不要加在这里

# ---------- 3. 日志与备份 ----------
*.log
*.bak

# ---------- 4. 系统垃圾文件 ----------
.DS_Store
Thumbs.db
